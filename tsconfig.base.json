{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@yamajs/core": ["packages/core/src"],
      "@yamajs/node": ["packages/node/src"],
      "@yamajs/sdk": ["packages/sdk/src"],
      "@yamajs/openapi": ["packages/openapi/src"],
      "@yamajs/yama": ["packages/yama/src"],
      "@yamajs/docker": ["packages/docker/src"],
      "@yamajs/ci": ["packages/ci/src"],
      "@yamajs/cli": ["packages/cli/src"],
      "@yamajs/postgres": ["packages/postgres/src"],
      "@yamajs/fastify": ["packages/fastify/src"],
      "@yamajs/errors": ["packages/errors/src"],
      "@yamajs/adminx": ["packages/adminx/src"]
    }
  }
}

