{
  "name": "@yamajs/storage",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "Yama unified storage abstraction layer with extensibility support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/betagors/yamajs.git",
    "directory": "packages/storage"
  },
  "keywords": [
    "yama",
    "storage",
    "s3",
    "object-storage",
    "file-upload",
    "abstraction",
    "extensible"
  ],
  "license": "MPL-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.build.json",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@yamajs/kernel": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
