{
  "name": "@yamajs/runtime-node",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "Yama Node.js runtime adapter",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/betagors/yama.git",
    "directory": "packages/node"
  },
  "keywords": [
    "yama",
    "runtime",
    "node",
    "adapter",
    "backend"
  ],
  "license": "MPL-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.build.json",
    "lint": "eslint  --ext .ts,.tsx",
    "lint:fix": "eslint  --ext .ts,.tsx --fix",
    "test": "node_modules/.bin/vitest",
    "test:watch": "node_modules/.bin/vitest --watch",
    "test:coverage": "node_modules/.bin/vitest --coverage",
    "clean": "node_modules/.bin/rimraf dist"
  },
  "dependencies": {
    "@yamajs/kernel": "workspace:*",
    "bcryptjs": "^2.4.3",
    "js-yaml": "^4.1.1",
    "dotenv": "^16.4.5"
  },
  "peerDependencies": {
    "@yamajs/server-fastify": "workspace:*",
    "@yamajs/plugin-openapi": "workspace:*",
    "@yamajs/db-drizzle": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@yamajs/server-fastify": {
      "optional": false
    },
    "@yamajs/plugin-openapi": {
      "optional": true
    },
    "@yamajs/db-drizzle": {
      "optional": true
    }
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}