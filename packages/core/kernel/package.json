{
  "name": "@yamajs/kernel",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "Yama - backend as config (core runtime and types)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/betagors/yama.git",
    "directory": "packages/core"
  },
  "keywords": [
    "yama",
    "backend",
    "framework",
    "api",
    "yaml",
    "config",
    "typescript"
  ],
  "license": "MPL-2.0",
  "scripts": {
    "build": "node_modules/.bin/tsup --config tsup.config.ts && tsc -p tsconfig.declarations.json",
    "dev": "node_modules/.bin/tsup --config tsup.config.ts --watch",
    "lint": "eslint  --ext .ts,.tsx",
    "lint:fix": "eslint  --ext .ts,.tsx --fix",
    "test": "node_modules/.bin/vitest",
    "test:watch": "node_modules/.bin/vitest --watch",
    "test:coverage": "node_modules/.bin/vitest --coverage",
    "clean": "node_modules/.bin/rimraf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@yamajs/errors": "workspace:*",
    "@yamajs/logging": "workspace:*",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "js-yaml": "^4.1.1",
    "semver": "^7.7.3"
  },
  "peerDependencies": {
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "peerDependenciesMeta": {
    "bcryptjs": {
      "optional": true
    },
    "jsonwebtoken": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.8",
    "@vitest/coverage-v8": "^1.0.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.2",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}